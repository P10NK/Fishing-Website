# Optional. Without a key, the free Open-Meteo endpoint is used.
# For commercial deployment, supply your customer API key.
OPEN_METEO_API_KEY=

# Optional. Raises the USGS Water Data API rate limit for local/hosted requests.
USGS_API_KEY=

# Google sign-in: create a Web application OAuth client with redirect URI
# https://castlinefishing.com/api/auth/google/callback (or localhost for development).
APP_ORIGIN=https://castlinefishing.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters. Keep this stable after launch so sessions remain valid.
AUTH_SECRET=
